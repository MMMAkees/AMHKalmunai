{
  "name": "amh-backend",
  "version": "1.0.0",
  "description": "AMH Smart Patient Flow - Express API (Laragon MySQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "node database/runSchema.js",
    "db:seed": "node database/seed.js",
    "db:setup": "npm run db:schema && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1"
  }
}
